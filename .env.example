# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
# Cadena de conexión a PostgreSQL. Funciona con cualquier proveedor:
# Neon, Railway, Vercel Postgres, RDS, o un Postgres local.
# Si esta variable NO está definida, la app arranca en "modo demo" usando
# los datos del seed en memoria (solo lectura). Para persistir datos,
# definí DATABASE_URL y corré las migraciones + seed.
DATABASE_URL="postgresql://usuario:password@localhost:5432/servicios_integrales?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Acceso al panel (protección interina, reemplazable por Supabase Auth)
# ---------------------------------------------------------------------------
# Si NO definís ninguna contraseña, /admin y /installer quedan ABIERTOS
# (modo dev/demo). Definí al menos una para exigir login.
# AUTH_SECRET: clave para firmar la sesión (obligatoria en producción).
# AUTH_SECRET="poné-una-clave-larga-y-secreta"
# AUTH_ADMIN_PASSWORD="clave-admin"
# AUTH_INSTALLER_PASSWORD="clave-instaladores"

# ---------------------------------------------------------------------------
# Preparado para el futuro (Fase 3): Supabase Auth + roles
# Todavía NO se usa. Documentado para dejar la arquitectura lista.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
