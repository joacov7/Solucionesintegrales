# ---------------------------------------------------------------------------
# Base de datos PostgreSQL (Neon)
# ---------------------------------------------------------------------------
# Si estas variables NO están definidas, la app arranca en "modo demo" usando
# los datos del seed en memoria (solo lectura). Para persistir datos, definilas
# y corré las migraciones + seed.
#
# Neon te da dos strings en el panel (Connect):
#   - DATABASE_URL → la POOLED, tiene "-pooler" en el host. La usa la app.
#   - DIRECT_URL   → la DIRECTA, SIN "-pooler". La usan las migraciones/seed.
# Ambas terminan en ?sslmode=require. Copiá tal cual de Neon.
#
# Ejemplo (reemplazá por tus valores reales):
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Acceso al panel (protección interina, reemplazable por Supabase Auth)
# ---------------------------------------------------------------------------
# En desarrollo sin contraseñas, el panel puede quedar abierto para demo.
# En producción, el acceso falla cerrado: requiere AUTH_SECRET (mín. 32 chars)
# y al menos una contraseña.
# AUTH_SECRET: generá un secreto aleatorio largo y único.
# AUTH_SECRET="reemplazar-por-secreto-aleatorio-de-32-caracteres-o-mas"
# AUTH_ADMIN_PASSWORD="clave-admin-larga-y-unica"
# AUTH_INSTALLER_PASSWORD="clave-instalador-larga-y-unica"
# AUTH_INSTALLER_ID="ID-del-registro-del-instalador-en-la-base-de-datos"
# El login interino soporta un instalador asignado por AUTH_INSTALLER_ID.
# Para varios instaladores se necesita autenticación individual.

# ---------------------------------------------------------------------------
# Preparado para el futuro (Fase 3): Supabase Auth + roles
# Todavía NO se usa. Documentado para dejar la arquitectura lista.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
