# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
# Cadena de conexión a PostgreSQL. Funciona con cualquier proveedor:
# Neon, Railway, Vercel Postgres, RDS, o un Postgres local.
# Si esta variable NO está definida, la app arranca en "modo demo" usando
# los datos del seed en memoria (solo lectura). Para persistir datos,
# definí DATABASE_URL y corré las migraciones + seed.
DATABASE_URL="postgresql://usuario:password@localhost:5432/servicios_integrales?schema=public"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

